# Copy to .env. Never commit real credentials.
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000

# Resend: verified sender domain and a sending-only API key.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=

# Leave false unless a trusted reverse proxy controls X-Forwarded-For.
# When true, the rightmost address is used, assuming one trusted proxy hop.
TRUST_PROXY=false
