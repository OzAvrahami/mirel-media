# Copy only if .env does not already exist. Never commit credentials.
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000

# Server-only: resend (default) or gmail. Case/outer whitespace are ignored.
# Missing/empty/whitespace-only values select resend. Restart after changes.
EMAIL_PROVIDER=resend

# Resend only: sending API key and sender on a verified Resend domain.
# Ignored when Gmail is selected. See docs/EMAIL_SETUP.md.
RESEND_API_KEY=
CONTACT_FROM=sender@your-domain.com

# Required for either provider: one recipient, which may differ from sender.
# Use plain addresses, not display names or comma-separated lists.
CONTACT_TO=inquiries@your-domain.com

# Gmail only: OAuth Desktop client credentials. See docs/GMAIL_SETUP.md.
# The local helper uses these and GMAIL_SENDER even if Resend is selected.
# Never put tokens or secrets in chat, Git, logs or frontend code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Written by npm run gmail:authorize. Only gmail.send scope is allowed.
GOOGLE_REFRESH_TOKEN=
# Exact account to authorize. A login hint does not verify the selected account.
GMAIL_SENDER=sender@your-domain.com

# Enable only behind one trusted proxy controlling/appending X-Forwarded-For.
# Uses the rightmost forwarded address. Preserve existing hosting ports.
TRUST_PROXY=false
