# Copy to .env. Never commit real credentials.
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000

# Server-only OAuth credentials. See docs/GMAIL_SETUP.md before filling these in.
# Create a Google OAuth Desktop app client; keep its ID and secret here/private hosting variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Written into local .env by npm run gmail:authorize; never paste tokens into chat or Git.
# The authorization must grant ONLY https://www.googleapis.com/auth/gmail.send.
GOOGLE_REFRESH_TOKEN=
# Authorize this exact Google Workspace mailbox. Sender and recipient are locked to it.
GMAIL_SENDER=lior@mirel-media.com
CONTACT_TO=lior@mirel-media.com

# Leave false unless a trusted reverse proxy controls X-Forwarded-For.
# When true, the rightmost address is used, assuming one trusted proxy hop.
TRUST_PROXY=false
